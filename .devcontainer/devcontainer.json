{
  "name": "jarvis-hud (Google Flow + Pipeline)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [3100, 6080],
  "portsAttributes": {
    "3100": {
      "label": "MCP Bridge (SSE)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "6080": {
      "label": "noVNC (phone browser)",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash flow-remote/codespace-setup.sh",
  "remoteEnv": {
    "DISPLAY": ":99"
  }
}
