# Copy this file to ".env" (same folder as server.js) and paste your real keys below.

# ── Gemini ────────────────────────────────────────────────────────────────────
# Get a Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# PORT=8787

# ── Google OAuth (for Google Flow Login) ──────────────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URI: http://localhost:8787/api/flow/auth/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/flow/auth/callback
