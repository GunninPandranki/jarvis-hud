# Copy this file to ".env" (same folder as server.js) and paste your real key below.
# Get a Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional overrides:
# GEMINI_MODEL=gemini-2.0-flash
# PORT=8787

# Cartesia text-to-speech (used by /api/tts). Get a key at: https://play.cartesia.ai/
CARTESIA_API_KEY=YOUR_API_KEY_HERE
