# Copy to .env and fill in whichever keys you have. Every stage degrades
# gracefully (falls back to a lower-signal free source, or a clearly-labeled
# stub) when a key is missing, so the pipeline always runs end to end.

# --- Trend Discovery sources ---
# YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# NewsAPI.org (https://newsapi.org)
NEWSAPI_KEY=

# Reddit + Google Trends (via RSS) + generic RSS feeds need no keys.

# --- LLM providers (research, fact-check, story, script, visual direction, QA) ---
# Anthropic is used by default when set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI is used as a fallback LLM, and for image generation + TTS if the
# dedicated keys below aren't set.
OPENAI_API_KEY=

# --- Image generation ---
# Set IMAGE_PROVIDER to pick which one is tried first: "openai" (default),
# "google" (Google Imagen via the Gemini API), or "stability". Whichever key
# below is actually set is used as a fallback for the others too, in the
# order openai -> google -> stability.
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1

# Google Imagen via the real Gemini API (NOT the Google Flow web app, which
# has no public API). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

STABILITY_API_KEY=

# --- Voice / TTS ---
# ElevenLabs preferred if set; otherwise falls back to OpenAI TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Misc ---
OUTPUT_DIR=./output
TOPIC_DB_PATH=./data/topics.json
